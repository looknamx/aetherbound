generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model MatchArchive {
  id String @id @default(cuid())
  roomKey String
  summary Json
  createdAt DateTime @default(now())
}
model ContentVersion {
  id String @id
  data Json
}
