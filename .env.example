PORT=3001
HOST=0.0.0.0
# Optional PostgreSQL match archive. Local JSON archive is used without this.
# DATABASE_URL=postgresql://aether:aether_local@localhost:5432/aetherbound
# Public deployment: set NODE_ENV=production and a fixed browser origin.
# CLIENT_ORIGIN=https://your-host.example
# Developer tools require BOTH settings and a loopback client.
ENABLE_DEV_TOOLS=false
NODE_ENV=development
